{
  "dashboard": {
    "title": "HTTP Overview",
    "uid": "http-overview",
    "panels": [
      {
        "title": "Request Rate (RPS)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application)",
            "legendFormat": "{{application}}"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      },
      {
        "title": "Error Rate (4xx + 5xx)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{status=~\"4..|5..\"}[1m])) by (application)",
            "legendFormat": "{{application}}"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      },
      {
        "title": "Response Time p50",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.5, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, application))",
            "legendFormat": "{{application}}"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      },
      {
        "title": "Response Time p95",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, application))",
            "legendFormat": "{{application}}"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      },
      {
        "title": "Response Time p99",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, application))",
            "legendFormat": "{{application}}"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      }
    ],
    "time": { "from": "now-1h", "to": "now" },
    "refresh": "10s",
    "schemaVersion": 39
  }
}
